{
  "name": "comeback-ai",
  "version": "1.0.0",
  "description": "The AI Recovery Coach That Helps You Restart — unified full-stack application",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:chat\"",
    "dev:web": "next dev",
    "dev:chat": "node services/chat/server.js",
    "dev:mobile": "cd mobile && npm run start",
    "build": "npm run build:web && npm run build:chat",
    "build:web": "next build",
    "build:chat": "tsc services/chat/server.ts --outDir dist --declaration",
    "build:mobile": "cd mobile && npm run build",
    "start": "npm run start:web",
    "start:web": "next start",
    "start:chat": "node dist/server.js",
    "lint": "next lint",
    "clean": "rm -rf .next dist node_modules"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@serwist/next": "^9.0.12",
    "@shopify/react-native-skia": "~1.2.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^13.6.1",
    "firebase-functions": "^7.0.5",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mongoose": "^8.12.1",
    "motion": "^12.23.24",
    "next": "^15.2.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "resend": "^4.1.2",
    "serwist": "^9.0.12",
    "socket.io": "^4.8.3",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.0.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.8.2"
  }
}
