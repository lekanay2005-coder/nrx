# ============================================================
# ComeBack.ai - Unified Master Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your actual values
# This configuration covers: Web App, Chat Server, Mobile, Database, AI, and External Services

# ============================================================
# NODE & APPLICATION
# ============================================================
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# DATABASE - MongoDB Atlas
# ============================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/comeback-ai?retryWrites=true&w=majority
MONGODB_DB_NAME=comeback-ai

# ============================================================
# DATABASE - Firebase / Firestore
# ============================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# ============================================================
# AI - Google Gemini & Generative AI
# ============================================================
GEMINI_API_KEY=your-google-gemini-api-key
GOOGLE_GENAI_API_KEY=your-google-genai-api-key
NEXT_PUBLIC_GOOGLE_GENAI_API_KEY=your-google-genai-api-key

# ============================================================
# AUTHENTICATION - JWT & Security
# ============================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
AUTH_SALT_ROUNDS=10

# ============================================================
# PAYMENT PROCESSING - Stripe
# ============================================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ============================================================
# EMAIL - Resend Service
# ============================================================
RESEND_API_KEY=your-resend-api-key
NEXT_PUBLIC_SUPPORT_EMAIL=support@comeback-ai.com

# ============================================================
# NOTIFICATIONS - Web Push & Firebase Cloud Messaging
# ============================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@comeback-ai.com

# ============================================================
# SOCKET.IO CHAT SERVER
# ============================================================
SOCKET_IO_PORT=3001
SOCKET_IO_CORS_ORIGIN=http://localhost:3000
SOCKET_IO_ADMIN_SETUP_KEY=your-admin-setup-key
SOCKET_IO_JWT_SECRET=your-socket-io-jwt-secret

# ============================================================
# EXTERNAL APIs & Services
# ============================================================
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project
GOOGLE_CLOUD_CREDENTIALS=/path/to/google-cloud-credentials.json

# ============================================================
# LOGGING & ANALYTICS
# ============================================================
LOG_LEVEL=debug
SENTRY_DSN=your-sentry-dsn-for-error-tracking

# ============================================================
# DEVELOPMENT & DEPLOYMENT
# ============================================================
NEXT_TELEMETRY_DISABLED=1
VERCEL_ENV=development
VERCEL_URL=localhost:3000

# ============================================================
# MOBILE APP (React Native / Expo)
# ============================================================
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_SOCKET_IO_URL=http://localhost:3001
EXPO_PUBLIC_FIREBASE_CONFIG_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_CONFIG_PROJECT_ID=your-firebase-project-id
